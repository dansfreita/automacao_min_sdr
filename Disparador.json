      "parameters": {
        "jsCode": "return items.map(item => {\n  const nome = item.json.Nome || \"cliente\";\n  const nicho = item.json.Nicho || \"seu negócio\";\n  const telefoneNumerico = item.json.Telefone.replace(/\\D/g, '');\n  const jid = `${telefoneNumerico}@s.whatsapp.net`;\n\n  // Mensagens para teste A/B/C/D\n  const mensagens = [$input.first().json.variacao_mensagem\n  ];\n\n  const index = Math.floor(Math.random() * mensagens.length);\n  const mensagem = mensagens[index];\n\n  const dataDisparo = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\n  return {\n    json: {\n      ...item.json,\n      mensagem,\n      jid,\n      variacao: mensagem, // Agora salva o texto da mensagem em vez do ID\n      data_ultimo_disparo: dataDisparo\n    }\n  };\n});\n"
      },
