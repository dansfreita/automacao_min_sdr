    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const nome = item.json.Nome || \"cliente\";\n  const nicho = item.json.Nicho || \"seu negócio\";\n  \n  // 1. Limpa tudo que não for número\n  let raw = item.json.Telefone.toString().replace(/\\D/g, '');\n  \n  // 2. Lógica Inteligente do 9º dígito (para DDDs brasileiros)\n  // Assumindo que a planilha pode vir com ou sem o '55' na frente\n  if (raw.startsWith('55')) {\n    raw = raw.substring(2); // Tira o 55 temporariamente para tratar o DDD\n  }\n  \n  const ddd = raw.slice(0, 2);\n  let restante = raw.slice(2);\n  \n  // Trata duplicidade de 9 ou falta dele\n  if (restante.startsWith('99')) {\n    restante = restante.substring(1);\n  } else if (!restante.startsWith('9') && restante.length >= 8) {\n    restante = '9' + restante;\n  }\n  \n  // Monta o telefone final perfeito com o 55\n  const telefoneNumerico = `55${ddd}${restante}`;\n  const jid = `${telefoneNumerico}@s.whatsapp.net`;\n\n  // Mensagens para teste A/B/C/D\n  const mensagens = [\n    $input.first().json.variacao_mensagem\n  ];\n\n  const index = Math.floor(Math.random() * mensagens.length);\n  const mensagem = mensagens[index];\n\n  const dataDisparo = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\n  return {\n    json: {\n      ...item.json,\n      telefone_limpo: telefoneNumerico, // Guarda o número limpo caso precise\n      mensagem,\n      jid,\n      variacao: mensagem, \n      data_ultimo_disparo: dataDisparo\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
